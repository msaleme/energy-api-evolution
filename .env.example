# Example environment configuration
# Copy this file to .env and update with your values

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=energyapi

# Kong Configuration  
KONG_PG_USER=kong
KONG_PG_PASSWORD=changeme

# InfluxDB Configuration
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=changeme
INFLUXDB_ADMIN_TOKEN=your-super-secret-token-here

# API Keys (obtain from providers)
WEATHER_API_KEY=your-api-key-here
EIA_API_KEY=your-api-key-here

# Environment
NODE_ENV=development
LOG_LEVEL=info

# Security Warning
# NEVER commit real credentials to version control
# Use environment variables or secret management systems in production